{
  "name": "@edwilde/ticketgraph",
  "version": "0.13.0",
  "description": "Token-efficient ticket queries over SQLite: CLI (ticketgraph) + opt-in MCP server.",
  "type": "module",
  "private": false,
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/edwilde/ticketgraph.git"
  },
  "homepage": "https://github.com/edwilde/ticketgraph#readme",
  "bugs": "https://github.com/edwilde/ticketgraph/issues",
  "keywords": [
    "tickets",
    "mcp",
    "claude",
    "sqlite",
    "cli",
    "task-tracking"
  ],
  "files": [
    "dist"
  ],
  "main": "./dist/server.js",
  "exports": {
    ".": "./dist/server.js"
  },
  "bin": {
    "ticketgraph": "./dist/server.js"
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run build && npm test",
    "setup": "node scripts/setup.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "better-sqlite3": "^11"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7",
    "@types/node": "^20",
    "tsup": "^8",
    "typescript": "^5",
    "vitest": "^1"
  }
}
