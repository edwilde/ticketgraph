{
  "name": "@edwilde/ticketgraph",
  "version": "0.13.0",
  "description": "Token-efficient ticket queries over SQLite — CLI (ticketgraph) + opt-in MCP server.",
  "type": "module",
  "private": false,
  "license": "MIT",
  "main": "./dist/server.js",
  "exports": {
    ".": "./dist/server.js"
  },
  "bin": {
    "ticketgraph": "./dist/server.js"
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "setup": "node scripts/setup.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "better-sqlite3": "^11"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7",
    "@types/node": "^20",
    "tsup": "^8",
    "typescript": "^5",
    "vitest": "^1"
  }
}
